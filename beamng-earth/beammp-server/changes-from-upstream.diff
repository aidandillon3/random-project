+-- ------------------------------------------------------------------------------------------------
+-- BeamMP sync. Added to the copy of the mod a BeamMP server sends its players (not in the original mod).
+-- BeamMP sends car positions as they are, and every game used to pick its own floating origin at each
+-- rebase, so after one the players disagreed on where everything was. Now each rebase (and each
+-- teleport that lands away from everyone) is announced to the server plugin Resources/Server/BeamNGEarthSync,
+-- which numbers it and passes it on; every game whose car is within the rebase distance of the
+-- newest announced anchor switches to that same lat/lon ('adopt', committed like a rebase). The same
+-- lat/lon gives the same frame in every game (geodesy.newAnchor). Outside a BeamMP session nothing runs.
+-- ------------------------------------------------------------------------------------------------
+mp.RANGE = 1.0           -- share an anchor whose centre is within the rebase distance of the car (nearer
+                         -- the edge it means one more rebase soon, which the others then share)
+mp.CHECK_S = 0.5         -- how often the announced anchors are checked
+mp.TELEPORT_WAIT_S = 3   -- after a teleport: announce our own anchor unless one nearby is adopted by then
+mp.ECHO_WAIT_S = 5       -- after an announcement: wait this long at most for the server's number
+
+function mp.reset()
+  mp.remote = {}         -- [server player id] = { lat, lon, seq } of each player's last announcement
+  mp.cur = nil           -- { lat, lon, seq } of our anchor (seq nil: not numbered by the server yet)
+  mp.checkAt, mp.waitEcho, mp.announceAt, mp.adopting, mp.helloSent = 0, nil, nil, nil, nil
+end
+mp.reset()
+
+function mp.active()
+  local core = rawget(_G, 'MPCoreNetwork')
+  if not (core and core.isMPSession and rawget(_G, 'TriggerServerEvent') and rawget(_G, 'AddEventHandler')) then
+    return false
+  end
+  local ok, on = pcall(core.isMPSession)
+  return ok and on == true
+end
+
+function mp.near(a, lat, lon)
+  return a ~= nil and math.abs(a.lat - lat) < 1e-7 and math.abs(a.lon - lon) < 1e-7
+end
+
+function mp.send(name, data)
+  if not mp.active() then return end
+  local ok, err = pcall(TriggerServerEvent, name, data)
+  if not ok then log('W', 'beamngEarth', 'BeamMP sync: ' .. tostring(err)) end
+end
+
+-- "seq|from|mine|lat|lon" from the server plugin
+function mp.onAnchor(data)
+  local seq, from, mine, lat, lon = string.match(tostring(data), '^(%d+)|(%-?%d+)|([01])|([^|]+)|([^|]+)$')
+  seq, lat, lon = tonumber(seq), tonumber(lat), tonumber(lon)
+  if not (seq and lat and lon) then return end
+  if mine == '1' then
+    mp.waitEcho = nil
+    if mp.near(mp.cur, lat, lon) and (mp.cur.seq or -1) < seq then mp.cur.seq = seq end
+  else
+    mp.remote[from] = { lat = lat, lon = lon, seq = seq }
+  end
+end
+
+function mp.onLeft(data)
+  mp.remote[tostring(data)] = nil
+end
+
+function mp.announce(lat, lon)
+  mp.announceAt = nil
+  mp.waitEcho = st.clock + mp.ECHO_WAIT_S
+  mp.send('bngEarthAnnounce', string.format('%.10f|%.10f', lat, lon))
+end
+
+-- From commitAnchor. purpose: 'teleport', 'rebase', 'resync' (same anchor) or 'adopt'.
+function mp.committed(purpose, lat, lon)
+  if purpose == 'resync' then return end
+  local a = mp.adopting
+  mp.adopting = nil
+  if purpose == 'adopt' and a then
+    mp.cur = { lat = lat, lon = lon, seq = a.seq }
+    -- tell the others we are on it now: our last announcement no longer says where we are
+    mp.send('bngEarthOn', string.format('%d|%.10f|%.10f', a.seq, a.lat, a.lon))
+    return
+  end
+  mp.cur = { lat = lat, lon = lon }
+  if purpose == 'rebase' then
+    mp.announce(lat, lon)
+  else
+    mp.announceAt = st.clock + mp.TELEPORT_WAIT_S -- a friend's anchor nearby is adopted instead, if there is one
+  end
+end
+
+-- Every frame from updateWorld (car placed, st.player known).
+function mp.update(pl)
+  if not mp.active() then return end
+  if not mp.registered then
+    mp.registered = true
+    AddEventHandler('bngEarthAnchor', mp.onAnchor, 'beamngEarthSync')
+    AddEventHandler('bngEarthLeft', mp.onLeft, 'beamngEarthSync')
+  end
+  if not mp.helloSent then
+    mp.helloSent = true -- once per level (mp.reset clears it): the server answers with every player's anchor
+    mp.send('bngEarthHello', 'hi')
+  end
+  if st.clock < mp.checkAt then return end
+  mp.checkAt = st.clock + mp.CHECK_S
+  if not st.anchor or not mp.cur or st.rebasing or st.paused then return end
+  local p = st.pending
+  if p and p.purpose ~= 'rebase' then return end -- a teleport, resync or adopt is under way
+  if mp.waitEcho and st.clock < mp.waitEcho then return end
+  local mine = mp.cur.seq or -1
+  local best, bx, by
+  local range2 = (mp.RANGE * rebase.distance) ^ 2
+  for _, r in pairs(mp.remote) do
+    if r.seq > mine and (not best or r.seq > best.seq) then
+      r.anchor = r.anchor or geodesy.newAnchor(r.lat, r.lon)
+      local x, y = st.anchor:transformTo(r.anchor):apply(pl.x, pl.y, pl.z)
+      if x * x + y * y < range2 then best, bx, by = r, x, y end
+    end
+  end
+  if best then
+    if mp.near(mp.cur, best.lat, best.lon) then -- already on it (both teleported to the same spot)
+      mp.cur.seq, mp.announceAt = best.seq, nil
+      return
+    end
+    if requestAnchor(best.lat, best.lon, 'adopt', follow.target(bx, by, pl.vx, pl.vy)) then
+      mp.adopting, mp.announceAt = best, nil
+      log('I', 'beamngEarth', string.format('BeamMP sync: switching to the shared anchor %.5f, %.5f (#%d)',
+        best.lat, best.lon, best.seq))
+    end
+    return
+  end
+  if mp.announceAt and st.clock >= mp.announceAt then mp.announce(mp.cur.lat, mp.cur.lon) end
+end
