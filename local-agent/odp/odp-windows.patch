+#ifdef _WIN32
+// Windows has no pread: each thread opens its own handle (reads on one synchronous handle are
+// serialized) and reads at an offset with ReadFile + OVERLAPPED.
+static bool read_range(const std::filesystem::path & path, uint8_t * dst, uint64_t offset, uint64_t n) {
+    HANDLE h = CreateFileW(path.c_str(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr,
+                           OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+    if (h == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    bool ok = true;
+    while (n > 0) {
+        const DWORD want = (DWORD) std::min<uint64_t>(n, 1u << 30);
+        OVERLAPPED ov = {};
+        ov.Offset     = (DWORD) (offset & 0xFFFFFFFFu);
+        ov.OffsetHigh = (DWORD) (offset >> 32);
+        DWORD got = 0;
+        if (!ReadFile(h, dst, want, &got, &ov) || got == 0) {
+            ok = false;
+            break;
+        }
+        dst += got;
+        offset += got;
+        n -= got;
+    }
+    CloseHandle(h);
+    return ok;
+}
+#endif
